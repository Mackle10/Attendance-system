# Environment Variables – Attendi Business Suite
# Copy this file to .env and fill in values. Never commit .env to version control.

# ──────────────────────────────────────────────
# API
# ──────────────────────────────────────────────
# Base URL of your backend REST API
VITE_API_BASE_URL=https://api.your-backend.com

# API request timeout in milliseconds
VITE_API_TIMEOUT=10000

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
VITE_APP_NAME=Attendi Business Suite
VITE_APP_VERSION=1.0.0

# ──────────────────────────────────────────────
# Authentication
# ──────────────────────────────────────────────
# Secret key used for token storage (optional – for encryption)
VITE_TOKEN_SECRET=your_token_secret_here

# ──────────────────────────────────────────────
# Feature Flags (true | false)
# ──────────────────────────────────────────────
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_NOTIFICATIONS=true
